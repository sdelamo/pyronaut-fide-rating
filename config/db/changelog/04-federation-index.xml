<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
  <changeSet id="04" author="username">
    <!-- lists the federations of a rating list and ranks one federation's players by standard rating -->
    <createIndex tableName="player" indexName="idx_player_period_fed_standard_rating">
      <column name="rating_year"/>
      <column name="rating_month"/>
      <column name="fed"/>
      <column name="standard_rating"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
