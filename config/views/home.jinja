<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FIDE ratings</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; }
  form { display: flex; gap: .5rem; }
  input { flex: 1; padding: .5rem; font-size: 1rem; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: .4rem .5rem; border-bottom: 1px solid #ddd; }
  .num { text-align: right; }
  .federations { columns: 14rem; list-style: none; padding: 0; }
  .federations li { padding: .15rem 0; }
  .code { color: #666; font-size: .8rem; }
  .count { color: #666; }
  button { padding: .5rem 1rem; font-size: 1rem; }
</style>
</head>
<body>
<h1>FIDE ratings</h1>
<form action="/fide/ratings" method="get">
  <input type="text" name="fide_id" inputmode="numeric" pattern="[0-9]+" placeholder="FIDE ID" aria-label="FIDE ID" required autofocus>
  <button type="submit">Show ratings</button>
</form>
{% if players %}<p class="count"><strong>{{ players }}</strong> players in the {{ period }} rating list</p>
{% endif %}
{% if top %}<h2>Top 10 by standard rating</h2>
<table>
  <thead><tr><th>#</th><th>Player</th><th>Fed</th><th class="num">Standard</th></tr></thead>
  <tbody>
  {% for player in top %}<tr><td>{{ player.rank }}</td><td><a href="{{ player.link }}">{{ player.name|escape }}</a></td><td>{{ player.federation|escape }}</td><td class="num">{{ player.rating }}</td></tr>
  {% endfor %}</tbody>
</table>
{% endif %}
{% if federations %}<h2>Federations</h2>
<ul class="federations">
  {% for federation in federations %}<li>{{ federation.flag }} <a href="{{ federation.link }}">{{ federation.name|escape }}</a> <span class="code">{{ federation.code|escape }}</span></li>
  {% endfor %}</ul>
{% endif %}</body>
</html>
